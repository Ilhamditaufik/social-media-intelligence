@'
# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Application
APP_ENV=development
LOG_LEVEL=INFO
'@ | Set-Content -Encoding utf8 .env.example